# ── REQUIRED ──
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Comma-separated allowlist of chat IDs. Leave empty = public bot.
# Get your chat_id from @userinfobot on Telegram.
TELEGRAM_CHAT_ID=

# ── TUNING (optional, safe defaults) ──
BULK_WORKERS=32
BULK_TIMEOUT=6
BULK_MAX_URLS=100000
BULK_MAX_BYTES=10485760
BULK_RATE_LIMIT=30
BULK_AUTO_MAX_URLS=10000000
BULK_AUTO_BATCH=500
BULK_AUTO_EXPAND=1
BULK_REGIONAL_PROB=0.05
FIREBASE_DEFAULT_KEY=12
FILE_INTERVAL_MIN=30
